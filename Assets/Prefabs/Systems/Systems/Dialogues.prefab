  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 632c8ca43cabfcc4f8ccbc2fda18be39, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  textDirection: 1
  delayBeforeText: 0
  imageDelay: 0
  typeSpeed: 0.05
  audioMode: 1
  typingSound: {fileID: 0}
  voiceSound: {fileID: 2719923382696503512}
  speakerSprite: {fileID: 21300000, guid: 248037d521a92ca4ea586f6c54eefcc8, type: 3}
  sentence: "\uFEE2\uFEE8\uFB91\uFBFF\uFEE3 \uFB8E\uFEAD\uFEA9 \uFEE1\uFEAD\uFE8D\uFEA9
    \uFEE9\uFEAE\uFEA7\uFEFB\uFE8E\uFE91\r\n\uFEE5\uFEA9\uFEAE\uFEE3 \uFBFC\uFE8D\uFEAE\uFE91
    \uFEAA\uFBFE\uFEAA\uFEB7 \uFEB1\uFE8E\uFEB4\uFEA3\uFE8D \uFEE6\uFBFE\uFE8D\r\n\u061F\uFEEA\uFEE7
    ... \uFE96\uFEB4\uFBFF\uFEE7 \uFE96\uFEA3\uFE8D\uFEAD \uFEAD\uFEAA\uFED8\uFEE7\uFE8D
    \uFBFD\uFEDF\uFEED\r\n\u061F\uFEEA\uFEE7 \uFEEA\uFEE8\uFBFF\uFEE4\uFEEB \uFEEA\uFEA7\uFEAE\uFB7C
    \uFEE6\uFBFE\uFE8D \uFED1\uFEAA\uFEEB\r\n\u061F\uFEE2\uFEB8\uFB91\uFE91 \uFEEE\uFEE3\uFEA9\uFEEE\uFEA7
    \uFEE2\uFEE7\uFEEE\uFE98\uFE91 \uFEE6\uFEE3 \uFE8E\uFE97 \uFEE9\uFEAA\uFEB7 \uFEEA\uFE98\uFEA7\uFE8E\uFEB3
    \uFEEA\uFEA7\uFEAE\uFB7C \uFEE6\uFBFE\uFE8D\r\n\u061F\uFEEA\uFEE7 \uFEEA\uFB95\uFEE3
    ...\uFEE2\uFE98\uFEA7\uFE8E\uFEB3 \uFEEE\uFEE7\uFE8E\uFEEC\uFE9F \uFEE6\uFBFE\uFE8D
    \uFEE6\uFEE3\r\n\uFEE2\uFEE8\uFB90 \uFEEA\uFE91\uFEAE\uFEA0\uFE97 \uFEED\uFEAD
    \uFB92\uFEAE\uFEE3 \uFEE6\uFBFE\uFEAE\uFBFF\uFEB7 \uFEE9\uFEB0\uFEE3 \uFEED \uFEE2\uFEB8\uFB91\uFE91
    \uFEEE\uFEE3\uFEA9\uFEEE\uFEA7 \uFEE2\uFEE7\uFEEE\uFE98\uFBFF\uFEE3 \uFEE6\uFEE3
    \uFEE5\uFEAA\uFEB7 \uFEE9\uFEA9\uFE8E\uFEE3\uFE81 \uFBFD\uFE98\uFED7\uFEED \uFE96\uFBFE\uFE8E\uFEEC\uFEE7
    \uFEAD\uFEA9 \uFBFD\uFEDF\uFEED \uFEE6\uFEB7 \uFEE9\uFEA9\uFE8E\uFEE3\uFE8D \uFE8E\uFEEB
    \uFEA9\uFEAD\uFE8D\uFEED \uFEE9\uFEAF\uFE8E\uFE97 \uFE8E\uFE97 \uFEE9\uFEAE\uFE92\uFBFF\uFEE3
    \uFEE5\uFE8E\uFEE3\uFEAF \uFEE2\uFB91\uFBFE\r\n \uFEC2\uFED8\uFED3\r\n\uFEAA\uFBFE\uFE8E\uFE91\r\n\uFEE2\uFEE8\uFB90
    \uFEDE\uFEE4\uFEA4\uFE97\r\n\uFEE2\uFEB8\uFB91\uFEE7 \uFEED\uFEAD \uFEE1\uFEA9\uFEEE\uFEA7
    \uFEAA\uFECB\uFEEE\uFEE3 \uFEAF\uFE8D \uFEAE\uFE97 \uFEA9\uFEED\uFEAF"
  choices:
  - "\uFEB0\uFBFE\uFEB0\uFECB \uFE96\uFEB3\uFEED\uFEA9 \uFEBA\uFB91\uFEE7 (1"
  - "\uFEB0\uFBFE\uFEB0\uFECB \uFE96\uFEB3\uFEED\uFEA9 \uFEBA\uFB91\uFE91 (2"
  actions:
  - m_PersistentCalls:
